# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails that can open /admin. Compared case-insensitively. Empty means nobody is an admin.
# ADMIN_EMAILS=you@example.com

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/your_database

# CloudHike Auth
AUTH_URL=https://your-project.cloudhike.dev/auth
AUTH_PUBLISHABLE_KEY=your-publishable-key
AUTH_SECRET_KEY=your-secret-key

# CloudHike Storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CloudHike Jobs (runs screen generation in the background)
JOBS_API_URL=
JOBS_API_KEY=
# The URL Jobs calls this app on. Defaults to NEXT_PUBLIC_APP_URL. Jobs refuses localhost,
# so in development use a tunnel, e.g. `ngrok http 3000`.
# JOBS_PUBLIC_URL=
# How long one build step (one screen) can take: up to 300 on Free, 3600 on Pro. Defaults to 300.
# JOBS_TIMEOUT_SECONDS=

# Connect to CloudHike: lets people use their own CloudHike account as their app's backend.
# Create the app in CloudHike under Settings > API & apps > Developer apps, and register this
# callback URL exactly: <NEXT_PUBLIC_APP_URL>/api/cloudhike/callback
CLOUDHIKE_CLIENT_ID=
CLOUDHIKE_CLIENT_SECRET=
# Encrypts people's CloudHike tokens and credentials in the database. Changing it means everyone
# has to connect again and connected apps stop working until then. Generate: openssl rand -base64 32
CLOUDHIKE_ENCRYPTION_KEY=

# Push to GitHub: lets people push their app's code to their own GitHub repositories.
# Create an OAuth app under GitHub > Settings > Developer settings > OAuth Apps, and register this
# callback URL exactly: <NEXT_PUBLIC_APP_URL>/api/github/callback
# Tokens are encrypted with CLOUDHIKE_ENCRYPTION_KEY above, so that has to be set too.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ImageKit: stores, generates, and transforms the images in people's apps. When true, and with both
# keys set, the agent generates its images with ImageKit and edit mode has the AI image tools. Otherwise
# apps use placeholder images, and an image can only be changed by its url.
IMAGEKIT_ENABLED=false
# Both are under Developer options in the ImageKit dashboard. The private key stays on the server.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Bachs subscriptions. https://docs.bachs.io/build/use-cases/saas-subscriptions
# Create a monthly USD product in the Bachs dashboard and put its id here. Subscriptions bill USD cards.
# A sk_sandbox_ key calls https://sandbox-api.bachs.io. A sk_live_ key calls https://api.bachs.io.
# Point a webhook at <NEXT_PUBLIC_APP_URL>/api/billing/webhook and subscribe it to
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
# invoice.paid, and invoice.payment_failed. BACHS_WEBHOOK_SECRET is that endpoint's whsec_ secret.
# Checkout return URLs have to be public. Leave NEXT_PUBLIC_APP_URL on localhost and Bachs will not
# redirect back; forward webhooks with: bachs listen --forward-to localhost:3000/api/billing/webhook
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_PRO_PRODUCT_ID=
# The price the pricing page shows. Keep it the same as the Bachs product. Defaults to $20.
# NEXT_PUBLIC_PRO_PRICE_LABEL=$20

# Which provider runs first, and which one is used when that call fails before any output.
# Primary: cloudhike, gemini, or openrouter. Defaults to cloudhike. Admin can switch this, and the model, at /admin/builder.
# Fallback: cloudhike, gemini, openrouter, or none. Defaults to the next ready provider when its key is set.
AI_PRIMARY_PROVIDER=cloudhike
AI_FALLBACK_PROVIDER=gemini
# CloudHike AI (OpenAI-compatible endpoint). Required when CloudHike is primary or fallback.
AI_BASE_URL=https://cloudhike.dev/api/ai-service/your-project/v1
AI_API_KEY=your-cloudhike-ai-key
# Gemini on Google AI. Required when Gemini is primary or fallback. A Google AI Studio key.
GOOGLE_AI_API_KEY=your-google-ai-studio-key
# GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter (OpenAI-compatible). Required when OpenRouter is primary or fallback.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CloudHike model ids. Used when CloudHike is the primary or the fallback.
# Planner defaults to claude-sonnet-5-5. Builder uses the planner model when CLOUDHIKE_BUILDER_MODEL is unset.
CLOUDHIKE_MODEL=moonshotai/kimi-k3.1-pro
CLOUDHIKE_BUILDER_MODEL=anthropic/claude-sonnet-5.5
# AI inside generated apps. One Groq key covers text, voice, and photos. The builder keys
# above stay separate. A person clicks Allow AI, and their app calls this server.
# https://console.groq.com/docs/reasoning
# https://console.groq.com/docs/speech-to-text
# https://console.groq.com/docs/vision
GROQ_API_KEY=
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3
# Text to speech. English Orpheus. A line is at most 200 characters.
# GROQ_SPEECH_MODEL=canopylabs/orpheus-v1-english
# GROQ_SPEECH_VOICE=austin
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Gemini model ids. Used when Gemini is the primary or the fallback.
# Planner defaults to gemini-3.8-flash. Builder uses the planner model when GEMINI_BUILDER_MODEL is unset.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BUILDER_MODEL=gemini-3.5-flash
# Realtime builder voice prompts (home + workspace). Needs GOOGLE_AI_API_KEY above.
# GEMINI_LIVE_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
# OpenRouter model ids. Used when OpenRouter is the primary or the fallback.
# Planner and builder default to qwen/qwen4-max. Builder uses the planner model when OPENROUTER_BUILDER_MODEL is unset.
OPENROUTER_MODEL=qwen/qwen4-max
# OPENROUTER_BUILDER_MODEL=qwen/qwen4-max
# How many screens an app plan has at most, unless the person asks for more (1 to 10, defaults to 3)
DEFAULT_SCREEN_COUNT=3

